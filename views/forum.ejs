<%- include('partials/header', { title: 'Forum', siteName, motto, currentPath, currentUser }) %>
<section class="page-hero"><div class="container page-hero-grid"><div class="page-hero-card"><div class="breadcrumbs"><a href="/">Home</a> / Forum</div><p class="eyebrow">Community Board</p><h1>Announcements, reports, and regiment posts.</h1><p>This forum page uses session-based login and a SQLite-backed post table so signed-in members can create posts from the site itself.[web:83][web:87]</p><% if (currentUser) { %><p class="notice">Signed in as <strong><%= currentUser.username %></strong> — <%= currentUser.role %>.</p><% } else { %><p class="notice">Sign in to create posts.</p><% } %></div><div class="page-hero-art"><img src="/public/assets/hero-soldier.jpg" alt="3rd Cavalry Regiment soldier artwork" width="1920" height="1080" loading="lazy"></div></div></section>
<section class="section surface"><div class="container"><div class="forum-grid"><article class="forum-card"><p class="eyebrow">Create Post</p><h2>Post a unit update</h2><% if (currentUser) { %><form class="form-stack" action="/posts" method="post"><label><span>Title</span><input type="text" name="title" required></label><label><span>Content</span><textarea name="body" required></textarea></label><button class="btn btn-primary" type="submit">Publish Post</button></form><% } else { %><p>You need to be logged in before you can publish on the forum.</p><a class="btn btn-primary" href="/login">Go to Login</a><% } %></article><article class="forum-card"><p class="eyebrow">Posting Rules</p><h2>Board guidance</h2><div class="forum-list"><div class="forum-row"><strong>Regimental Announcements</strong><span>Leadership Team</span><span>Priority</span></div><div class="forum-row"><strong>After Action Reports</strong><span>Operations Staff</span><span>Archive</span></div><div class="forum-row"><strong>Applications & Introductions</strong><span>Recruitment</span><span>Open</span></div><div class="forum-row"><strong>Suggestions & Feedback</strong><span>Public Board</span><span>Review</span></div></div></article></div></div></section>
<section class="section"><div class="container timeline"><% posts.forEach(post => { %><article class="post-card"><h3><%= post.title %></h3><p class="notice">By <strong><%= post.username %></strong> — <%= post.role %> • <%= post.created_at %></p><p><%= post.body %></p></article><% }) %></div></section>
<%- include('partials/footer', { siteName, motto }) %>
