<%- include('partials/header', { title: 'MOS Assignment', siteName, motto, currentPath, currentUser }) %>
<section class="page-hero"><div class="container page-hero-grid"><div class="page-hero-card"><div class="breadcrumbs"><a href="/">Home</a> / MOS Assignment</div><p class="eyebrow">Unit Selection | MOS Assignment</p><h1>Squadrons, troops, and opening status.</h1><p>Your ORBAT and unit selection details are separated into a dedicated assignment page for easier browsing.</p></div><div class="page-hero-art"><img src="/public/assets/hero-stryker.jpg" alt="Stryker vehicle banner" width="1920" height="400" loading="lazy"></div></div></section>
<section class="section surface"><div class="container accordion-group"><% mosBlocks.forEach((block, index) => { %><details class="mos-block" <%= index === 0 ? 'open' : '' %>><summary><%= block.title %> <span class="status <%= block.status.toLowerCase() === 'open' ? 'open' : 'closed' %>"><%= block.status %></span></summary><div class="mos-content"><ul><% block.items.forEach(item => { %><li><%= item %></li><% }) %></ul></div></details><% }) %></div></section>
<%- include('partials/footer', { siteName, motto }) %>
