<%- include('partials/header', { title: 'Medals', siteName, motto, currentPath, currentUser }) %>
<section class="page-hero"><div class="container page-hero-grid"><div class="page-hero-card"><div class="breadcrumbs"><a href="/">Home</a> / Medals</div><p class="eyebrow">Awards & Recognition</p><h1>Medals, ribbons, and soldier recognition.</h1><p>This page gives the regiment a realistic awards presentation with original ribbon-style visuals and award criteria.</p></div><div class="page-hero-art"><img src="/public/assets/logo-hero.jpg" alt="3rd Cavalry Regiment emblem" width="400" height="400" loading="lazy"></div></div></section>
<section class="section surface"><div class="container medal-grid"><% medals.forEach(medal => { %><article class="medal-card"><div class="medal-ribbon <%= medal.ribbon %>"></div><span class="medal-tier"><%= medal.tier %></span><h3><%= medal.title %></h3><p><%= medal.text %></p></article><% }) %></div></section>
<%- include('partials/footer', { siteName, motto }) %>
