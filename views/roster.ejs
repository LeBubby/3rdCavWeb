<%- include('partials/header', { title: 'Roster', siteName, motto, currentPath, currentUser }) %>
<section class="page-hero"><div class="container page-hero-grid"><div class="page-hero-card"><div class="breadcrumbs"><a href="/">Home</a> / Roster</div><p class="eyebrow">Roster Page</p><h1>Regimental roster and troop identity.</h1><p>A separate roster page makes the site feel closer to a unit portal than a simple recruitment landing page.</p></div><div class="page-hero-art"><img src="/public/assets/hero-soldier.jpg" alt="Soldier with Brave Rifles overlay" width="1920" height="1080" loading="lazy"></div></div></section>
<section class="section surface"><div class="container roster-grid"><% roster.forEach(item => { %><article class="roster-card"><img src="<%= item.image %>" alt="<%= item.title %> visual" width="400" height="300" loading="lazy"><h3><%= item.title %></h3><p class="role-pill"><%= item.subtitle %></p><p><%= item.text %></p></article><% }) %></div></section>
<%- include('partials/footer', { siteName, motto }) %>
