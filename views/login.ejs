<%- include('partials/header', { title: 'Login', siteName, motto, currentPath, currentUser }) %>
<section class="page-hero"><div class="container page-hero-grid"><div class="page-hero-card"><div class="breadcrumbs"><a href="/">Home</a> / Login</div><p class="eyebrow">Account Access</p><h1>Sign in or create an account.</h1><p>This app uses Express sessions for login state, and password hashes are stored in SQLite rather than plain text.[web:83][web:87]</p><p class="notice">Default admin account: <strong>admin</strong> / <strong>admin123</strong>. Change this after setup.</p></div><div class="page-hero-art"><img src="/public/assets/logo-hero.jpg" alt="3rd Cavalry Regiment logo" width="400" height="400" loading="lazy"></div></div></section>
<section class="section surface"><div class="container login-grid"><article class="login-card"><p class="eyebrow">Login</p><h2>Member sign in</h2><% if (error) { %><p class="notice" style="color: var(--color-danger);"><%= error %></p><% } %><form class="form-stack" action="/login" method="post"><label><span>Username</span><input type="text" name="username" required></label><label><span>Password</span><input type="password" name="password" required></label><button class="btn btn-primary" type="submit">Sign In</button></form></article><article class="login-card"><p class="eyebrow">Register</p><h2>Create member account</h2><form class="form-stack" action="/register" method="post"><label><span>Username</span><input type="text" name="username" required></label><label><span>Password</span><input type="password" name="password" required minlength="6"></label><button class="btn btn-secondary" type="submit">Register</button></form></article></div></section>
<%- include('partials/footer', { siteName, motto }) %>
